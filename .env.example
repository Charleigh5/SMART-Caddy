# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_TEXT_MODEL: The model to use for text/vision processing.
# Defaults to gemini-2.5-flash if not set.
GEMINI_TEXT_MODEL="gemini-2.5-flash"

# GEMINI_LIVE_MODEL: The model to use for Gemini Live (WebSocket) sessions.
# Defaults to gemini-2.0-flash-exp if not set.
GEMINI_LIVE_MODEL="gemini-2.0-flash-exp"

# ENABLE_GEMINI_LIVE: Set to "true" to enable the real Gemini Live WebSocket provider.
# If "false" or unset, the system will use an honest rest fallback for testing.
ENABLE_GEMINI_LIVE="true"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
